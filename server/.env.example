# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Asterisk Manager Interface (AMI) ---
AMI_HOST=192.168.2.136
AMI_PORT=5038
AMI_USERNAME=crmtoken
AMI_SECRET=changeme

# Dialplan context used to originate outbound calls (Originate Context/Exten/Priority).
# Ask your Asterisk admin which context the operator extensions dial out through.
AMI_ORIGINATE_CONTEXT=from-internal
AMI_ORIGINATE_PRIORITY=1

# Channel technology prefix used to build "<TECH>/<extension>" when calling an
# operator's phone: SIP for chan_sip peers, PJSIP for chan_pjsip endpoints.
# Don't guess — check a live Newchannel event's "Channel" field for your
# extension (e.g. "PJSIP/101-0000abcd" vs "SIP/101-0000abcd").
AMI_CHANNEL_TECH=PJSIP

# Which extensions to watch for the "my calls" list — every call on them is
# tracked, including ones not placed through this app (dialed directly from
# MicroSIP, or genuine inbound calls). "*" = every internal extension the PBX
# has (recommended: new operators are picked up automatically). A comma-
# separated list (e.g. 101,102,103) limits it to those. Click-to-call always
# tracks its own calls regardless.
TRACK_EXTENSIONS=*

# --- HTTP/WS server exposed to the browser client ---
HTTP_PORT=3001

# Shared secret the browser must send as "X-Api-Key" header (and "?token=" on the
# WebSocket URL). Generate a random string, e.g.: openssl rand -hex 24
API_TOKEN=changeme

# Browser origin allowed to call this API (set to your static site's origin).
# Use "*" only for local/LAN testing.
FRONTEND_ORIGIN=*

# --- CallFlow web panel (call recordings) ---
# Separate system from AMI — the CRM/PBX web panel (port 80). Only used to
# fetch call recording audio: login form -> session cookie -> stream_file=.
CALLFLOW_BASE_URL=http://callflow.local
CALLFLOW_USERNAME=changeme
CALLFLOW_PASSWORD=changeme

# Contacts are no longer polled from an XML feed — the external system pushes
# them via POST /api/contacts/upsert (keyed by client code), authenticated
# with the same API_TOKEN as everything else.
